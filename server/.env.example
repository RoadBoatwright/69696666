# 多平台广告投放与商机获客集成 - 环境变量示例
# 复制为 .env 并填入真实值。凭据类配置项仅通过环境/配置接口注入，禁止硬编码（需求 1.6）。
#
# 优雅降级（需求 1.4）：DB / Redis 暂不可用时，应用按退避自动重试连接而非崩溃，
# 连接状态可通过 GET /health 端点查看。

# ---- 应用 ----
APP_PORT=3000
APP_ENV=development

# ---- 数据库 (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=ad_integration

# ---- 缓存 / 队列 (Redis) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 凭据加密 (KMS 信封加密；无 KMS 时降级为本地对称加密) ----
# KMS 主密钥标识；留空则使用本地 AES-256-GCM 降级模式
KMS_KEY_ID=
# 本地降级模式主密钥（仅开发环境使用，生产应托管于 KMS）
LOCAL_ENCRYPTION_KEY=

# ---- 平台凭据（占位符；由管理员经配置接口后填入真实值，禁止硬编码，需求 1.6） ----
# 以下仅为占位说明，实际凭据通过凭据管理器配置接口提交并加密存储，不从环境直读。
# Meta: appId / appSecret / systemUserToken / businessManagerId
# Google: clientId / clientSecret / refreshToken / developerToken / loginCustomerId
# TikTok: appId / appSecret / accessToken / refreshToken / businessCenterId
# Gemini（底层生成式 AI，需求 15.1）: apiKey
